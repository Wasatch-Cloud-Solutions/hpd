generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMINISTRATOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipRole {
  MEMBER
  MANAGER
}

enum MessageType {
  GENERAL
  ANNOUNCEMENT
  URGENT
  SHIFT_UPDATE
  INVENTORY_UPDATE
}

enum TransactionType {
  ADDITION
  REMOVAL
  MANUAL_CORRECTION
  INITIAL_COUNT
  ITEM_CREATED
  ITEM_ARCHIVED
}

enum NotificationType {
  MESSAGE
  ANNOUNCEMENT
  INVENTORY_CHANGE
  LOW_STOCK
  TEAM_MEMBERSHIP
}

enum Platform {
  IOS
  ANDROID
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  fullName        String          @map("full_name") @db.VarChar(160)
  email           String          @unique @db.VarChar(320)
  passwordHash    String          @map("password_hash")
  profileImageUrl String?         @map("profile_image_url")
  role            Role            @default(EMPLOYEE)
  tokenVersion    Int             @default(0) @map("token_version")
  accountStatus   AccountStatus   @default(ACTIVE) @map("account_status")
  preferences     Json            @default("{}")
  lastActiveAt    DateTime?        @map("last_active_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  memberships     TeamMembership[]
  messages        Message[]
  inventoryCreated InventoryItem[] @relation("InventoryCreatedBy")
  inventoryUpdated InventoryItem[] @relation("InventoryUpdatedBy")
  transactions    InventoryTransaction[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  reactions       MessageReaction[]
  messageReads    MessageRead[]
  deviceTokens    DeviceToken[]
  teamsCreated    Team[]          @relation("TeamCreatedBy")

  @@index([role, accountStatus])
  @@map("users")
}

model Team {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @unique @db.VarChar(120)
  description   String          @default("") @db.Text
  isActive      Boolean         @default(true) @map("is_active")
  createdById   String?         @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  memberships   TeamMembership[]
  createdBy     User?           @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  inventory     InventoryTeamAssignment[]
  transactions  InventoryTransaction[]
  messages      Message[]
  notifications Notification[]

  @@index([isActive, name])
  @@map("teams")
}

model TeamMembership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  teamId         String         @map("team_id") @db.Uuid
  membershipRole MembershipRole @default(MEMBER) @map("membership_role")
  joinedAt       DateTime       @default(now()) @map("joined_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  team           Team           @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([userId, teamId])
  @@index([teamId, membershipRole])
  @@map("team_memberships")
}

model InventoryItem {
  id             String                    @id @default(uuid()) @db.Uuid
  name           String                    @db.VarChar(180)
  description    String?                   @db.Text
  category       String?                   @db.VarChar(120)
  sku            String?                   @db.VarChar(100)
  unit           String                    @db.VarChar(40)
  quantity       Decimal?                  @db.Decimal(12, 3)
  minimumStock   Decimal?                  @map("minimum_stock") @db.Decimal(12, 3)
  supplier       String?                   @db.VarChar(180)
  costPerUnit    Decimal?                  @map("cost_per_unit") @db.Decimal(12, 2)
  createdById    String                    @map("created_by") @db.Uuid
  updatedById    String                    @map("updated_by") @db.Uuid
  isArchived     Boolean                   @default(false) @map("is_archived")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  createdBy      User                      @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                      @relation("InventoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  teams          InventoryTeamAssignment[]
  transactions   InventoryTransaction[]

  @@index([name, isArchived])
  @@index([category])
  @@map("inventory_items")
}

model InventoryTeamAssignment {
  id              String        @id @default(uuid()) @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  teamId          String        @map("team_id") @db.Uuid
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([inventoryItemId, teamId])
  @@index([teamId])
  @@map("inventory_team_assignments")
}

model InventoryTransaction {
  id               String          @id @default(uuid()) @db.Uuid
  inventoryItemId  String          @map("inventory_item_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  teamId           String?         @map("team_id") @db.Uuid
  previousQuantity Decimal?        @map("previous_quantity") @db.Decimal(12, 3)
  newQuantity      Decimal?        @map("new_quantity") @db.Decimal(12, 3)
  adjustmentAmount Decimal?        @map("adjustment_amount") @db.Decimal(12, 3)
  transactionType  TransactionType @map("transaction_type")
  notes            String?         @db.Text
  idempotencyKey   String          @unique @map("idempotency_key") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  item             InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  team             Team?           @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@map("inventory_transactions")
}

model Message {
  id              String           @id @default(uuid()) @db.Uuid
  teamId          String           @map("team_id") @db.Uuid
  senderId        String           @map("sender_id") @db.Uuid
  parentMessageId String?          @map("parent_message_id") @db.Uuid
  content         String           @db.Text
  messageType     MessageType      @default(GENERAL) @map("message_type")
  isPinned        Boolean          @default(false) @map("is_pinned")
  editedAt        DateTime?        @map("edited_at")
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  sender          User             @relation(fields: [senderId], references: [id], onDelete: Restrict)
  parent          Message?         @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Restrict)
  replies         Message[]        @relation("MessageReplies")
  reactions       MessageReaction[]
  reads           MessageRead[]

  @@index([teamId, createdAt])
  @@map("messages")
}

model MessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_reads")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reaction  String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
  @@map("message_reactions")
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  teamId           String?          @map("team_id") @db.Uuid
  notificationType NotificationType @map("notification_type")
  title            String           @db.VarChar(180)
  body             String           @db.Text
  relatedEntityId  String?          @map("related_entity_id") @db.Uuid
  isRead           Boolean          @default(false) @map("is_read")
  createdAt        DateTime         @default(now()) @map("created_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  pushToken String   @unique @map("push_token")
  platform  Platform
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String   @map("entity_id") @db.Uuid
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  createdAt      DateTime @default(now()) @map("created_at")
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(120)
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
